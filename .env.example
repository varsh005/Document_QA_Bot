# Copy this file to .env and fill in your own values. Never commit .env.

# Get this free at https://aistudio.google.com/apikey (no credit card required)
GEMINI_API_KEY=your-gemini-key-here

# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-string
DJANGO_DEBUG=True

# Models - check https://ai.google.dev/gemini-api/docs/pricing for current
# free-tier model names, since Google renames/retires models periodically.
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash

# RAG tuning
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=4
